{
    "manifest_version": 3,
    "name": "TikTok Background Player",
    "version": "0.0.1",
    "description": "Prevent TikToks from pausing when the tab is in the background.",
    "content_scripts": [
        {
            "matches": ["*://*.tiktok.com/*"],
            "js": ["content.js"],
            "run_at": "document_start",
            "type": "module"
        }
    ]
}